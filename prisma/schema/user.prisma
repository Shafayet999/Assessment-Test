model User {
  id              String      @id @default(uuid())
  email           String      @unique
  password        String?     // GCP Social Login এর ক্ষেত্রে password null হতে পারে
  name            String
  role            UserRole    @default(CANDIDATE)
  status          UserStatus  @default(ACTIVE)
  profileImage    String?
  credits         Int         @default(0) // Recruiter assessments পাবলিশ করতে ক্রেডিট কিনবে
  isDeleted       Boolean     @default(false)
  deletedAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Relationships
  recruiterAssessments Assessment[]          @relation("RecruiterAssessments")
  candidateAttempts    CandidateAssessment[]
  payments             Payment[]
  auditLogs            AuditLog[]

  @@index([email])
  @@index([role, status])
  @@map("users")
}
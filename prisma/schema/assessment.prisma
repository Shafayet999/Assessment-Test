model Assessment {
  id              String           @id @default(uuid())
  title           String
  description     String?
  durationMinutes Int              // টাইমড টেস্ট (যেমন: ৬০ মিনিট)
  totalMarks      Int              @default(100)
  passMarks       Int              @default(40)
  status          AssessmentStatus @default(DRAFT)
  recruiterId     String
  isDeleted       Boolean          @default(false)
  deletedAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Relationships
  recruiter       User                  @relation("RecruiterAssessments", fields: [recruiterId], references: [id], onDelete: Cascade)
  questions       AssessmentQuestion[]
  candidates      CandidateAssessment[]

  @@index([recruiterId])
  @@index([status])
  @@map("assessments")
}
model Question {
  id             String       @id @default(uuid())
  title          String
  description    String       // প্রবলেম স্টেটমেন্ট বা প্রশ্ন
  type           QuestionType @default(MCQ)
  difficulty     Difficulty   @default(MEDIUM)
  options        Json?        // MCQ এর অপশনসমূহ: ["A", "B", "C", "D"]
  correctAnswer  String?      // MCQ এর সঠিক উত্তর (অটো-ইভ্যালুয়েশনের জন্য)
  marks          Int          @default(10)
  isDeleted      Boolean      @default(false)
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relationships
  assessmentLinks AssessmentQuestion[]
  submissions     Submission[]

  @@index([type, difficulty])
  @@map("questions")
}